{
  "name": "@tarmo-randma/pi-ephemeral",
  "version": "0.1.2",
  "description": "Make Pi resources optional and context-activated",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "resource-manager",
    "skills",
    "prompts",
    "themes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarmo-randma/pi-ephemeral.git"
  },
  "bugs": {
    "url": "https://github.com/tarmo-randma/pi-ephemeral/issues"
  },
  "homepage": "https://github.com/tarmo-randma/pi-ephemeral#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-ephemeral": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/pi-ephemeral.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples/minimal-skill-package"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/package/**",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "test:package": "vitest run tests/package/installed-package.test.ts"
  },
  "dependencies": {
    "@tarmo-randma/t3-pi-refresh": "git+ssh://git@github.com/tarmo-randma/t3-pi-refresh.git#cdcbf02475fa88e7eac9d79a0305c0008ae13253"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
